# Copy into ~/.ssh/config or Include this file.
# Replace the example hostnames and local private-key path.
# Both routes reach the same sshd and use the same OS account/key.

Host omv8-cf
    HostName ssh.example.com
    User root
    ProxyCommand cloudflared access ssh --hostname %h
    IdentityFile ~/.ssh/ghostfleet_admin
    IdentitiesOnly yes
    HostKeyAlias ghostfleet-omv8
    StrictHostKeyChecking accept-new
    ServerAliveInterval 20
    ServerAliveCountMax 3
    ConnectTimeout 15
    TCPKeepAlive yes

Host omv8-ts
    HostName omv8.tailnet-name.ts.net
    User root
    IdentityFile ~/.ssh/ghostfleet_admin
    IdentitiesOnly yes
    HostKeyAlias ghostfleet-omv8
    StrictHostKeyChecking accept-new
    ServerAliveInterval 20
    ServerAliveCountMax 3
    ConnectTimeout 15
    TCPKeepAlive yes
