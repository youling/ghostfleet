# Replace both reserved hostnames and the local private-key path.
# Install cloudflared on the operator client as well as on the target; this ProxyCommand runs locally.
# The executable must be resolvable by the SSH client; if it is not on PATH, use its actual absolute path.
# This alias expects a Cloudflare Published Application service type SSH (ssh://...:22), not TCP.
# Enroll the host key out of band; use one unique HostKeyAlias per machine.
# This machine shares "ghostfleet-node" across both routes; other machines need other aliases.

Host node-cf
    HostName ssh.example.invalid
    User root
    ProxyCommand cloudflared access ssh --hostname %h
    IdentityFile ~/.ssh/ghostfleet_admin
    IdentitiesOnly yes
    ForwardAgent no
    HostKeyAlias ghostfleet-node
    StrictHostKeyChecking yes
    ServerAliveInterval 20
    ServerAliveCountMax 3
    ConnectTimeout 15
    TCPKeepAlive yes

Host node-ts
    HostName node.tailnet-name.example.invalid
    User root
    IdentityFile ~/.ssh/ghostfleet_admin
    IdentitiesOnly yes
    ForwardAgent no
    HostKeyAlias ghostfleet-node
    StrictHostKeyChecking yes
    ServerAliveInterval 20
    ServerAliveCountMax 3
    ConnectTimeout 15
    TCPKeepAlive yes
