{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostfleet-control-plane",
  "main": "src/adapters/cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "GHOSTFLEET_STATE", "class_name": "GhostFleetState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GhostFleetState"] }],
  "assets": { "directory": "dist/console", "binding": "ASSETS" },
  // This Worker now serves the node credential endpoints too, so the bypass
  // hostnames stay off: the only public address is the deployment's own zone
  // (routes/custom domain are deployment configuration, never committed here).
  "workers_dev": false,
  "preview_urls": false
}
