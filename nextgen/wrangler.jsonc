{
  "name": "ghostfleet-nextgen-isolated",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "GHOSTFLEET_STATE", "class_name": "GhostFleetState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GhostFleetState"] }],
  "version_metadata": { "binding": "NEXTGEN_VERSION" },
  "vars": {
    "GHOSTFLEET_PANEL_ORIGIN": "https://panel.example.invalid",
    "GHOSTFLEET_NODE_ORIGIN": "https://node.example.invalid"
  }
}
