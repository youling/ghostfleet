{
  // Public immutable material origin. No Access policy, no secrets, no API: the
  // Worker only serves content-addressed files that were reviewed and built by
  // scripts/build-assets.mjs.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ghostfleet-assets",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../dist/assets",
    "binding": "ASSETS",
    // Every request goes through the Worker allowlist instead of being served
    // directly by the asset layer.
    "run_worker_first": true
  },
  // Bypasses that would publish the same bytes under an unreviewed hostname.
  // Keep both false: the ONLY public address is the deployment's own zone.
  "workers_dev": false,
  "preview_urls": false
  // The custom domain/route belongs to the private deployment, which adds a
  // "routes" entry for its own zone at deploy time. This file never names it.
}
