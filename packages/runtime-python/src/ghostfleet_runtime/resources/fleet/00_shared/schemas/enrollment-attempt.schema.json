{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:youling-fleet:schema:enrollment-attempt:1.0.0",
  "title": "CF-A enrollment attempt metadata 1.0.0",
  "description": "Non-secret private snapshot; protected secret slot is excluded. State transitions/CAS/authority/time/provider evidence require the Enrollment Attempt contract and T2 implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "attempt_id", "node_uid", "manifest_digest", "mint_request_digest", "revision", "state", "mint_reserved", "provider_key_id", "credential_ref", "join_evidence_ref", "completion_digest", "terminal_evidence_ref", "device_resolution", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol": {"const": "fleet-enrollment-attempt/v1"},
    "attempt_id": {"type": "string", "pattern": "^attempt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "node_uid": {"type": "string", "pattern": "^node-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "mint_request_digest": {"$ref": "#/$defs/digest"},
    "revision": {"type": "integer", "minimum": 0},
    "state": {"enum": ["PREPARED", "MINTING", "MINT_UNKNOWN", "MINTED", "CREDENTIAL_READY", "RELEASED", "JOIN_UNKNOWN", "JOIN_VERIFIED", "COMPLETE", "INVALIDATION_PENDING", "ABORTED"]},
    "mint_reserved": {"type": "boolean"},
    "provider_key_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "credential_ref": {"type": ["string", "null"], "pattern": "^secret-slot:[A-Za-z0-9._-]{1,128}$"},
    "join_evidence_ref": {"$ref": "#/$defs/evidence"},
    "completion_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "terminal_evidence_ref": {"$ref": "#/$defs/evidence"},
    "device_resolution": {"enum": ["UNKNOWN", "NOT_JOINED", "JOINED", "REMOVED"]},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "UTC, whole seconds; validate calendar/time and actual expiry separately from schema shape."}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["PREPARED", "MINTING", "MINT_UNKNOWN", "MINTED", "CREDENTIAL_READY", "RELEASED", "JOIN_UNKNOWN"]}}}, "then": {"properties": {"device_resolution": {"const": "UNKNOWN"}, "join_evidence_ref": {"type": "null"}}}},
    {"if": {"properties": {"device_resolution": {"const": "JOINED"}}}, "then": {"properties": {"join_evidence_ref": {"type": "string"}}}},
    {"if": {"properties": {"mint_reserved": {"const": false}}}, "then": {"properties": {"provider_key_id": {"type": "null"}, "device_resolution": {"enum": ["UNKNOWN", "NOT_JOINED"]}}}},
    {"if": {"properties": {"state": {"enum": ["MINTING", "MINT_UNKNOWN"]}}}, "then": {"properties": {"provider_key_id": {"type": "null"}}}},
    {"if": {"properties": {"state": {"const": "PREPARED"}}}, "then": {"properties": {"mint_reserved": {"const": false}, "provider_key_id": {"type": "null"}}}},
    {"if": {"properties": {"state": {"not": {"enum": ["PREPARED", "ABORTED"]}}}}, "then": {"properties": {"mint_reserved": {"const": true}}}},
    {"if": {"properties": {"state": {"enum": ["MINTED", "CREDENTIAL_READY", "RELEASED", "JOIN_UNKNOWN", "JOIN_VERIFIED", "COMPLETE"]}}}, "then": {"properties": {"provider_key_id": {"type": "string"}}}},
    {"if": {"properties": {"state": {"const": "CREDENTIAL_READY"}}}, "then": {"properties": {"credential_ref": {"type": "string"}}}, "else": {"properties": {"credential_ref": {"type": "null"}}}},
    {"if": {"properties": {"state": {"enum": ["JOIN_VERIFIED", "COMPLETE"]}}}, "then": {"properties": {"join_evidence_ref": {"type": "string"}, "device_resolution": {"const": "JOINED"}}}},
    {"if": {"properties": {"state": {"const": "COMPLETE"}}}, "then": {"properties": {"completion_digest": {"type": "string"}}}, "else": {"properties": {"completion_digest": {"type": "null"}}}},
    {"if": {"properties": {"state": {"const": "ABORTED"}}}, "then": {"properties": {"terminal_evidence_ref": {"type": "string"}, "device_resolution": {"enum": ["NOT_JOINED", "REMOVED"]}}}, "else": {"properties": {"terminal_evidence_ref": {"type": "null"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence": {"type": ["string", "null"], "pattern": "^evidence:[A-Za-z0-9._-]{1,128}$"}
  }
}
