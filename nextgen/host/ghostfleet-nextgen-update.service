[Unit]
Description=Pull GhostFleet software from the approved APT channel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/ghostfleet-nextgen/update.py
StateDirectory=ghostfleet-nextgen/software
StateDirectoryMode=0755
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
InaccessiblePaths=-/var/lib/ghostfleet-nextgen/private -/etc/ghostfleet-nextgen/enrollment.json -/etc/ssh
