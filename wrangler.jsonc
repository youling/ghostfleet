{
  "name": "ghostfleet-control-plane",
  "main": "src/adapters/cloudflare/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {"bindings": [{"name": "GHOSTFLEET_STATE", "class_name": "GhostFleetState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GhostFleetState"]}],
  "version_metadata": {"binding": "NEXTGEN_VERSION"},
  "ratelimits": [
    {"name": "NEXTGEN_CLAIM_LIMIT", "namespace_id": "14103", "simple": {"limit": 24, "period": 60}},
    {"name": "GHOSTFLEET_REPORT_LIMIT", "namespace_id": "14106", "simple": {"limit": 1200, "period": 60}}
  ],
  "assets": {"directory": "dist/console", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "GHOSTFLEET_PANEL_ORIGIN": "https://panel.example.invalid",
    "GHOSTFLEET_NODE_ORIGIN": "https://node.example.invalid"
  }
}
